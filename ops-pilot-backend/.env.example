# Backend environment variables
# Place this file as .env in the backend folder, or in the repository root.

PORT=8000
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VECTORSTORE_BASE_DIR=app/vectorstores
CHAT_MEMORY_MAX_TURNS=12
